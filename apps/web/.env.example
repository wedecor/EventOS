# Event OS Admin Portal (apps/web) — public env only (bundled into the static build).
# NestJS API is the sole backend. Do not put secrets here.

# Base URL of the Phase 1 API (no trailing slash). Default local API port is 3000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional app display name
NEXT_PUBLIC_APP_NAME=Event OS
