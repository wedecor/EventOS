# Application
# NODE_ENV: development | test | staging | production (validated by env.schema)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS (comma-separated origins). Development may use *; staging/production must be explicit (R1-06)
# Admin Portal local origin (apps/web `pnpm dev` uses port 3001)
CORS_ORIGIN=http://localhost:3001
# Also allow Sprint 1 Vite UAT if used locally: http://localhost:5173

# PostgreSQL (Prisma / Docker Compose)
DATABASE_URL=postgresql://eventos:eventos@localhost:5432/eventos?schema=public

# Redis is OPTIONAL. REDIS_URL is the only enable switch: when unset, throttling,
# login lockout and AI rate limits are in-memory (single instance only) and the
# Enquiries delivery ledger lives in Postgres. Local docker: redis://localhost:6379
# Memorystore later: redis://10.0.0.3:6379 (TLS: rediss://…).
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# JWT access-token signing key — required, minimum 32 characters (R1-04 / docs/16).
# Also used as key material for AES-256-GCM encryption of IntegrationSettings secrets
# (SMTP password / storage secret). Rotating JWT_SECRET invalidates encrypted settings
# until secrets are re-entered in Settings → Integrations.
JWT_SECRET=change-me-to-a-secure-secret-at-least-32-characters

# Seed bootstrap (optional — used by `pnpm prisma:seed`; never commit real passwords)
# SEED_ADMIN_PASSWORD=change-me-admin-seed-password

# Sentry error tracking (optional — leave unset for local development; R2-06)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# M3 — document storage (defaults: local filesystem under apps/api/.data/storage)
# STORAGE_PROVIDER=local|s3|none
STORAGE_PROVIDER=local
# STORAGE_LOCAL_ROOT=
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_MAX_UPLOAD_BYTES=10485760

# M3 — outbound email (defaults: in-process test adapter; not delivery proof)
# MAIL_PROVIDER=test|smtp|none
MAIL_PROVIDER=test
# MAIL_FROM_NAME=We Decor Events
# MAIL_FROM_EMAIL=ops@example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_IDEMPOTENCY_WINDOW_SEC=30
# MAIL_WEBHOOK_SECRET=

# M4-AI — Lead Intelligence / LLM (defaults: in-process test adapter; no live calls)
# AI_PROVIDER=test|openai|none
AI_PROVIDER=test
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=  # server-side only; required when AI_PROVIDER=openai; NEVER expose to NEXT_PUBLIC_*
# AI_TIMEOUT_MS=30000
# AI_MAX_RETRIES=1
# AI_INPUT_PRICE_PER_1M=0.15
# AI_OUTPUT_PRICE_PER_1M=0.60
# Abuse caps (Redis). Set to 0 to disable a dimension.
# AI_RATE_LIMIT_PER_USER_PER_HOUR=30
# AI_RATE_LIMIT_PER_TENANT_PER_HOUR=200
# AI_RATE_LIMIT_WINDOW_SECONDS=3600

# M5-01 — Firebase login bridge (temporary, ADR-019). Production uses Application Default
# Credentials (Cloud Run service account); GOOGLE_APPLICATION_CREDENTIALS is for local dev only
# and must stay out of git.
# FIREBASE_PROJECT_ID=wedecorenquries
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FIREBASE_AUTH_PROVIDER=firebase|test|none   # `test` is refused in staging/production

# M5-01 — Enquiries → EventOS booking feed (temporary). HMAC secret: >= 32 chars, from Secret
# Manager in deployed environments. SECRET_NEXT is the second active secret during rotation.
# ENQUIRIES_FEED_SECRET=
# ENQUIRIES_FEED_SECRET_NEXT=
# Tenant that receives synced bookings (never taken from the request). Required in staging/production;
# local/test fall back to the single Phase 1 tenant.
# ENQUIRIES_FEED_TENANT_ID=00000000-0000-0000-0000-000000000001
