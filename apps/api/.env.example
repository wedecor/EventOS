# Application
# NODE_ENV: development | test | staging | production (validated by env.schema)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS (comma-separated origins). Development may use *; staging/production must be explicit (R1-06)
# Admin Portal local origin (apps/web `pnpm dev` uses port 3001)
CORS_ORIGIN=http://localhost:3001

# PostgreSQL (Prisma / Docker Compose)
DATABASE_URL=postgresql://eventos:eventos@localhost:5432/eventos?schema=public

# Redis (cache, BullMQ, login throttle, sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT access-token signing key — required, minimum 32 characters (R1-04 / docs/16)
JWT_SECRET=change-me-to-a-secure-secret-at-least-32-characters

# Seed bootstrap (optional — used by `pnpm prisma:seed`; never commit real passwords)
# SEED_ADMIN_PASSWORD=change-me-admin-seed-password

# Sentry error tracking (optional — leave unset for local development; R2-06)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
