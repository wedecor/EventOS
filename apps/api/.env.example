# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS (comma-separated origins, or * for development)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (used by Docker Compose and future Prisma setup)
DATABASE_URL=postgresql://eventos:eventos@localhost:5432/eventos?schema=public

# Redis (cache, BullMQ, sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (placeholder — authentication not implemented in scaffold)
JWT_SECRET=change-me-to-a-secure-secret-at-least-32-characters
