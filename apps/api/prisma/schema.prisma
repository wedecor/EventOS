generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Platform (seed only — auth wiring added in Sprint 1 application layer)
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  customers  Customer[]
  leads      Lead[]
  quotations Quotation[]
  events     Event[]
  payments   Payment[]
  tasks      Task[]
  staffAssignments StaffAssignment[]
  inventoryMovements InventoryMovement[]
  vendors            Vendor[]
  vendorProcurements VendorProcurement[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  name         String
  role         String   @default("admin")
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignedLeads       Lead[]              @relation("LeadAssignee")
  leadStageChanges    LeadStageHistory[]  @relation("LeadStageChangedBy")
  executionOwnedEvents Event[]             @relation("EventExecutionOwner")
  staffAssignments    StaffAssignment[]   @relation("StaffAssignmentStaffMember")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Sprint 1 — W5 Lead → Booking
// ---------------------------------------------------------------------------

enum CustomerStatus {
  active
  inactive
  blocked

  @@map("customer_status")
}

enum CustomerType {
  individual
  organization

  @@map("customer_type")
}

enum LeadSource {
  website
  instagram
  whatsapp
  referral
  walk_in
  phone
  manual
  other

  @@map("lead_source")
}

enum LeadStage {
  new
  in_talks
  approved
  completed
  lost
  cancelled

  @@map("lead_stage")
}

enum FollowUpStatus {
  pending
  done
  cancelled

  @@map("follow_up_status")
}

enum QuotationStatus {
  draft
  sent
  approved
  rejected
  expired
  superseded

  @@map("quotation_status")
}

enum EventStatus {
  approved
  in_preparation
  in_execution
  completed
  cancelled

  @@map("event_status")
}

enum PaymentMethod {
  upi
  cash
  bank_transfer
  card
  cheque
  other

  @@map("payment_method")
}

enum PaymentStatus {
  confirmed
  void

  @@map("payment_status")
}

enum PreparationStatus {
  pending
  ready
  needs_attention

  @@map("preparation_status")
}

enum WorkspaceStatus {
  inactive
  active
  archived

  @@map("workspace_status")
}

model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  displayName  String         @map("display_name")
  type         CustomerType   @default(individual)
  status       CustomerStatus @default(active)
  primaryPhone String?        @map("primary_phone")
  primaryEmail String?        @map("primary_email")
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  version      Int            @default(1)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  leads      Lead[]
  quotations Quotation[]
  events     Event[]

  @@unique([tenantId, displayName])
  @@index([tenantId, status])
  @@map("customers")
}

model Lead {
  id                      String     @id @default(uuid()) @db.Uuid
  tenantId                String     @map("tenant_id") @db.Uuid
  customerId              String?    @map("customer_id") @db.Uuid
  assignedToId            String?    @map("assigned_to_id") @db.Uuid
  source                  LeadSource
  sourceDetail            String?    @map("source_detail")
  stage                   LeadStage  @default(new)
  lostReason              String?    @map("lost_reason")
  eventType               String?    @map("event_type")
  eventStartDate          DateTime?  @map("event_start_date") @db.Date
  eventEndDate            DateTime?  @map("event_end_date") @db.Date
  venue                   String?
  estimatedBudgetAmount   Decimal?   @map("estimated_budget_amount") @db.Decimal(12, 2)
  estimatedBudgetCurrency String     @default("INR") @map("estimated_budget_currency")
  guestCount              Int?       @map("guest_count")
  notes                   String?
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")
  version                 Int        @default(1)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer      Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedTo    User?              @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  event         Event?
  followUps     FollowUp[]
  stageHistory  LeadStageHistory[]
  quotations    Quotation[]

  @@index([tenantId, stage])
  @@index([tenantId, assignedToId])
  @@index([tenantId, source])
  @@index([tenantId, customerId])
  @@map("leads")
}

model LeadStageHistory {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  leadId      String     @map("lead_id") @db.Uuid
  fromStage   LeadStage? @map("from_stage")
  toStage     LeadStage  @map("to_stage")
  reason      String?
  changedById String?    @map("changed_by_id") @db.Uuid
  changedAt   DateTime   @default(now()) @map("changed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy User? @relation("LeadStageChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([tenantId, leadId])
  @@index([leadId, changedAt])
  @@map("lead_stage_history")
}

model FollowUp {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  leadId    String         @map("lead_id") @db.Uuid
  dueAt     DateTime       @map("due_at")
  notes     String?
  status    FollowUpStatus @default(pending)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  version   Int            @default(1)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
  @@index([tenantId, status, dueAt])
  @@map("follow_ups")
}

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  leadId          String?         @map("lead_id") @db.Uuid
  quotationNumber Int             @map("quotation_number")
  revisionNumber  Int             @default(1) @map("revision_number")
  status          QuotationStatus @default(draft)
  eventType       String?         @map("event_type")
  eventStartDate  DateTime?       @map("event_start_date") @db.Date
  eventEndDate    DateTime?       @map("event_end_date") @db.Date
  venue           String?
  validUntil      DateTime?       @map("valid_until") @db.Date
  terms           String?
  notes           String?
  subtotalAmount  Decimal         @default(0) @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount       Decimal         @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0) @map("total_amount") @db.Decimal(12, 2)
  currency        String          @default("INR")
  supersededById  String?         @unique @map("superseded_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  version         Int             @default(1)

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  event      Event?
  superseded Quotation? @relation("QuotationRevision", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes Quotation? @relation("QuotationRevision")
  lineItems  QuotationLineItem[]

  @@unique([tenantId, quotationNumber, revisionNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, leadId])
  @@map("quotations")
}

/// Unified event record (Booking module). Maps to domain aggregate "Event".
model Event {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  customerId          String            @map("customer_id") @db.Uuid
  leadId              String?           @unique @map("lead_id") @db.Uuid
  quotationId         String            @unique @map("quotation_id") @db.Uuid
  bookingNumber       Int               @map("booking_number")
  status              EventStatus       @default(approved)
  eventType           String?           @map("event_type")
  eventStartDate      DateTime?         @map("event_start_date") @db.Date
  eventEndDate        DateTime?         @map("event_end_date") @db.Date
  venueName           String?           @map("venue_name")
  guestCount          Int?              @map("guest_count")
  requirementsNotes   String?           @map("requirements_notes")
  workspaceStatus     WorkspaceStatus   @default(inactive) @map("workspace_status")
  preparationStatus   PreparationStatus @default(pending) @map("preparation_status")
  operationalMilestone String?          @map("operational_milestone")
  executionOwnerId    String?           @map("execution_owner_id") @db.Uuid
  cancellationReason  String?           @map("cancellation_reason")
  completedAt         DateTime?         @map("completed_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  version             Int               @default(1)

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  executionOwner User?     @relation("EventExecutionOwner", fields: [executionOwnerId], references: [id], onDelete: SetNull)
  payments       Payment[]
  tasks          Task[]
  staffAssignments StaffAssignment[]
  inventoryMovements InventoryMovement[]
  vendorProcurements VendorProcurement[]
  procurementLines   ProcurementLine[]

  @@unique([tenantId, bookingNumber])
  @@index([tenantId, status, eventStartDate])
  @@index([tenantId, executionOwnerId])
  @@index([tenantId, customerId])
  @@map("events")
}

// ---------------------------------------------------------------------------
// Sprint 1 — Payment (EP1-BR-001 advance gating)
// ---------------------------------------------------------------------------

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  bookingId          String?       @map("booking_id") @db.Uuid
  leadId             String?       @map("lead_id") @db.Uuid
  quotationId        String?       @map("quotation_id") @db.Uuid
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @default("INR")
  method             PaymentMethod
  status             PaymentStatus @default(confirmed)
  receivedAt         DateTime      @map("received_at")
  attachmentId       String?       @map("attachment_id") @db.Uuid
  missingProofReason String?       @map("missing_proof_reason")
  notes              String?
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  version            Int           @default(1)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking Event? @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([tenantId, bookingId])
  @@index([tenantId, leadId])
  @@index([tenantId, quotationId])
  @@index([tenantId, status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Sprint 1 — Quotation Line Items
// ---------------------------------------------------------------------------

model QuotationLineItem {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  quotationId   String   @map("quotation_id") @db.Uuid
  description   String
  quantity      Int      @default(1)
  unitPriceAmount Decimal @map("unit_price_amount") @db.Decimal(12, 2)
  currency      String   @default("INR")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  version       Int      @default(1)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  procurementLines ProcurementLine[]

  @@index([tenantId, quotationId])
  @@map("quotation_line_items")
}

// ---------------------------------------------------------------------------
// Sprint 2B — Task Management (EP1-OPS-003, EP1-AUT-003)
// ---------------------------------------------------------------------------

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled

  @@map("task_status")
}

/// Event-linked execution checklist / operational task (Task module, `07-domain-model.md` §Task).
model Task {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  bookingId   String     @map("booking_id") @db.Uuid
  title       String
  description String?
  assignedTo  String?    @map("assigned_to") @db.Uuid
  dueAt       DateTime?  @map("due_at")
  status      TaskStatus @default(pending)
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  version     Int        @default(1)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking        Event           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  checklistItems ChecklistItem[]

  @@index([tenantId, bookingId])
  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@map("tasks")
}

/// Owned checklist row under a Task (`07-domain-model.md` §Task — ChecklistItem entity).
model ChecklistItem {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  description String
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  version     Int       @default(1)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([tenantId, taskId])
  @@map("checklist_items")
}

// ---------------------------------------------------------------------------
// Sprint 2C — Staff Assignment (EP1-STF-002, EP1-AUT-004)
// ---------------------------------------------------------------------------

enum StaffAssignmentStatus {
  proposed
  confirmed
  released
  cancelled

  @@map("staff_assignment_status")
}

/// Staff member assigned to an event (Staff module, `07-domain-model.md` §Staff Assignment).
/// `staffMemberId` references the existing `User` model — Phase 1 reuses the auth identity already
/// used for `Lead.assignedToId` / `Event.executionOwnerId` since a dedicated `StaffMember` staff
/// master (EP1-STF-001) is out of scope for Sprint 2C (see implementation report).
model StaffAssignment {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  bookingId          String                @map("booking_id") @db.Uuid
  staffMemberId      String                @map("staff_member_id") @db.Uuid
  role               String?
  isOnSiteLead       Boolean               @default(false) @map("is_on_site_lead")
  reportingAt        DateTime?             @map("reporting_at")
  note               String?
  status             StaffAssignmentStatus @default(proposed)
  confirmedAt        DateTime?             @map("confirmed_at")
  releasedAt         DateTime?             @map("released_at")
  cancelledAt        DateTime?             @map("cancelled_at")
  cancellationReason String?               @map("cancellation_reason")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  version            Int                   @default(1)

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking     Event  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  staffMember User   @relation("StaffAssignmentStaffMember", fields: [staffMemberId], references: [id], onDelete: Restrict)

  @@index([tenantId, bookingId])
  @@index([tenantId, staffMemberId])
  @@index([tenantId, status])
  @@map("staff_assignments")
}

// ---------------------------------------------------------------------------
// Sprint 3 — Inventory Movement (EP1-INV-003, EP1-INV-005, EP1-INV-006)
// ---------------------------------------------------------------------------

enum InventoryMovementStatus {
  planned
  picked
  packed
  loaded
  at_venue
  returned
  cleaned_ready

  @@map("inventory_movement_status")
}

/// Per-event stock movement through preparation and return (`07-domain-model.md` §Inventory
/// Movement, `docs/business/08-inventory-workflow.md` §11). `inventoryItemId` is stored as a plain
/// tenant-scoped identifier (no FK) because the `InventoryItem` master (EP1-INV-001/EP1-INV-002) is
/// out of scope for Sprint 3 — same deferral pattern as `Payment.attachmentId` for the not-yet-built
/// `Attachment` aggregate (see implementation report).
model InventoryMovement {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  bookingId       String                  @map("booking_id") @db.Uuid
  inventoryItemId String                  @map("inventory_item_id") @db.Uuid
  quantity        Int                     @default(1)
  notes           String?
  status          InventoryMovementStatus @default(planned)
  pickedAt        DateTime?               @map("picked_at")
  packedAt        DateTime?               @map("packed_at")
  loadedAt        DateTime?               @map("loaded_at")
  atVenueAt       DateTime?               @map("at_venue_at")
  returnedAt      DateTime?               @map("returned_at")
  cleanedReadyAt  DateTime?               @map("cleaned_ready_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  version         Int                     @default(1)

  tenant      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking     Event                         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  damageNotes InventoryMovementDamageNote[]

  @@index([tenantId, bookingId, status])
  @@index([tenantId, inventoryItemId, status])
  @@map("inventory_movements")
}

/// Accountability note for damage/loss on a movement (`EP1-INV-006`). Append-only — no update or
/// delete endpoint is documented, matching the `LeadStageHistory` immutable-log pattern.
model InventoryMovementDamageNote {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  movementId     String    @map("movement_id") @db.Uuid
  message        String
  accountability String?
  occurredAt     DateTime? @map("occurred_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  movement InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@index([tenantId, movementId])
  @@map("inventory_movement_damage_notes")
}

// ---------------------------------------------------------------------------
// Sprint 4 — Vendor Procurement (EP1-VEN-001, 002, 003, 005, 006)
// ---------------------------------------------------------------------------

// Per `docs/business/07-vendor-management.md` §11A "Vendor Status Model" (explicit 5-value
// status field) and `07-domain-model.md` §Vendor ("Preferred/backup is classification, not a
// separate aggregate" — i.e. folded into this single status field rather than a second table).
enum VendorStatus {
  preferred
  active
  backup
  paused
  blocked

  @@map("vendor_status")
}

enum ProcurementLineStatus {
  planned
  requested
  confirmed
  delivered
  completed

  @@map("procurement_line_status")
}

// Fixed reason list per `docs/business/07-vendor-management.md` §11 "Cost Variance Reason
// (Phase 1 Requirement)" — required whenever actual procurement cost exceeds budget (EP1-VEN-005).
enum CostVarianceReason {
  market_price_increase
  vendor_price_change
  vendor_change_availability_quality
  customer_scope_change
  emergency_purchase
  material_wastage_damage
  incorrect_estimation
  other

  @@map("cost_variance_reason")
}

enum IssueNoteSeverity {
  low
  medium
  high

  @@map("issue_note_severity")
}

/// Vendor directory with status + lightweight issue history (`07-domain-model.md` §Vendor,
/// EP1-VEN-001, EP1-VEN-006). Tax details are optional per `07-vendor-management.md` §11A.
model Vendor {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  name              String
  category          String
  status            VendorStatus @default(active)
  contactName       String?      @map("contact_name")
  contactPhone      String?      @map("contact_phone")
  location          String?
  servicesProvided  String?      @map("services_provided")
  pricingNotes      String?      @map("pricing_notes")
  paymentTerms      String?      @map("payment_terms")
  taxDetails        String?      @map("tax_details")
  notes             String?
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  version           Int          @default(1)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  issueNotes   VendorIssueNote[]
  procurements VendorProcurement[]

  @@index([tenantId, status])
  @@index([tenantId, category])
  @@map("vendors")
}

/// Vendor-level feedback note (`07-domain-model.md` §Vendor — VendorIssueNote entity, EP1-VEN-006).
/// Append-only, matching the `InventoryMovementDamageNote` precedent.
model VendorIssueNote {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  vendorId   String             @map("vendor_id") @db.Uuid
  message    String
  severity   IssueNoteSeverity  @default(medium)
  occurredAt DateTime?          @map("occurred_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([tenantId, vendorId])
  @@map("vendor_issue_notes")
}

/// Procurement header per event-vendor pairing (`07-domain-model.md` §Vendor Procurement AR,
/// EP1-VEN-002). `status` mirrors `ProcurementLineStatus` for the header summary; Phase 1 exposes
/// no dedicated header-transition endpoint (see implementation report).
model VendorProcurement {
  id        String                 @id @default(uuid()) @db.Uuid
  tenantId  String                 @map("tenant_id") @db.Uuid
  bookingId String                 @map("booking_id") @db.Uuid
  vendorId  String                 @map("vendor_id") @db.Uuid
  status    ProcurementLineStatus  @default(planned)
  notes     String?
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  version   Int                    @default(1)

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking Event             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  vendor  Vendor            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines   ProcurementLine[]

  @@index([tenantId, bookingId])
  @@index([tenantId, vendorId])
  @@map("vendor_procurements")
}

/// Procurement line item (`07-domain-model.md` §Vendor Procurement — ProcurementLine entity,
/// EP1-VEN-002/003/005). `bookingId` is denormalized onto the line per `08-data-model.md`
/// §Procurement Persistence ("Each ProcurementLine stores: event_id, vendor_procurement_id,
/// optional quotation_line_item_id"). `quotationLineItemId` is a real FK (unlike
/// `InventoryMovement.inventoryItemId`) because `QuotationLineItem` already exists from Sprint 1.
model ProcurementLine {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  vendorProcurementId String              @map("vendor_procurement_id") @db.Uuid
  bookingId           String              @map("booking_id") @db.Uuid
  quotationLineItemId String?             @map("quotation_line_item_id") @db.Uuid
  description         String
  category            String
  quantity            Int                 @default(1)
  budgetedAmount      Decimal?            @map("budgeted_amount") @db.Decimal(12, 2)
  actualAmount        Decimal?            @map("actual_amount") @db.Decimal(12, 2)
  currency            String              @default("INR")
  status              ProcurementLineStatus @default(planned)
  requestedAt         DateTime?           @map("requested_at")
  confirmedAt         DateTime?           @map("confirmed_at")
  deliveredAt         DateTime?           @map("delivered_at")
  completedAt         DateTime?           @map("completed_at")
  costVarianceAmount  Decimal?            @map("cost_variance_amount") @db.Decimal(12, 2)
  costVarianceReason  CostVarianceReason? @map("cost_variance_reason")
  notes               String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  version             Int                 @default(1)

  vendorProcurement VendorProcurement          @relation(fields: [vendorProcurementId], references: [id], onDelete: Restrict)
  booking           Event                      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  quotationLineItem QuotationLineItem?         @relation(fields: [quotationLineItemId], references: [id], onDelete: SetNull)
  issueNotes        ProcurementLineIssueNote[]

  @@index([tenantId, vendorProcurementId])
  @@index([tenantId, bookingId, status])
  @@map("procurement_lines")
}

/// Line-level issue note (`07-domain-model.md` §Vendor Procurement — ProcurementLineIssueNote
/// entity, EP1-VEN-006). Append-only, matching the `InventoryMovementDamageNote` precedent.
model ProcurementLineIssueNote {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  procurementLineId String            @map("procurement_line_id") @db.Uuid
  message           String
  severity          IssueNoteSeverity @default(medium)
  occurredAt        DateTime?         @map("occurred_at")
  createdAt         DateTime          @default(now()) @map("created_at")

  procurementLine ProcurementLine @relation(fields: [procurementLineId], references: [id], onDelete: Cascade)

  @@index([tenantId, procurementLineId])
  @@map("procurement_line_issue_notes")
}
