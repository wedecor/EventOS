generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Platform (seed only — auth wiring added in Sprint 1 application layer)
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  sessions   Session[]
  customers  Customer[]
  leads      Lead[]
  quotations Quotation[]
  events     Event[]
  payments   Payment[]
  tasks      Task[]
  staffAssignments StaffAssignment[]
  staffMembers     StaffMember[]
  staffAvailability StaffAvailability[]
  staffLeave       StaffLeave[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  inventoryReservations InventoryReservation[]
  inventoryVerifications InventoryVerification[]
  inventoryDamageReports InventoryDamageReport[]
  suggestions        Suggestion[]
  tenantSettings     TenantSettings?
  vendors            Vendor[]
  vendorProcurements VendorProcurement[]
  procurementQuotes  ProcurementQuote[]
  purchaseOrders     PurchaseOrder[]
  procurementTimelineEvents ProcurementTimelineEvent[]
  invoices           Invoice[]
  vendorExpenses     VendorExpense[]
  financialDocuments FinancialDocument[]
  financialDocumentAuditEvents FinancialDocumentAuditEvent[]
  communicationRecords CommunicationRecord[]
  communicationTemplates CommunicationTemplate[]
  communicationAttachments CommunicationAttachment[]
  reminders Reminder[]
  notificationPreferences NotificationPreference[]
  auditLogs          AuditLog[]
  passwordHistory    PasswordHistory[]
  timelineEntries    TimelineEntry[]
  contacts           Contact[]
  issueNotes         IssueNote[]
  reviewRequests     ReviewRequest[]
  eventNotes         EventNote[]
  checklistTemplates ChecklistTemplate[]
  eventChecklists    EventChecklist[]

  @@map("tenants")
}

/// Phase 1 tenant settings (R3-04 / EP1-KPI-007). Typed columns only — no JSONB bag.
/// One row per tenant (ADR-016 single We Decor tenant in Phase 1).
model TenantSettings {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @unique @map("tenant_id") @db.Uuid
  businessName           String   @map("business_name")
  monthlyEventTarget     Int?     @map("monthly_event_target")
  monthlyRevenueTarget   Decimal? @map("monthly_revenue_target") @db.Decimal(12, 2)
  monthlyLeadTarget      Int?     @map("monthly_lead_target")
  averageBookingTarget   Decimal? @map("average_booking_target") @db.Decimal(12, 2)
  conversionRateTarget   Decimal? @map("conversion_rate_target") @db.Decimal(8, 6)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  version                Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_settings")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  name         String
  role         String   @default("admin")
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  version      Int      @default(1)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions            Session[]
  passwordHistory     PasswordHistory[]
  assignedLeads       Lead[]              @relation("LeadAssignee")
  leadStageChanges    LeadStageHistory[]  @relation("LeadStageChangedBy")
  executionOwnedEvents Event[]             @relation("EventExecutionOwner")
  /// Legacy expand-contract column on assignments (P2-04); remove after Phase 3 cutover.
  legacyStaffAssignments StaffAssignment[] @relation("StaffAssignmentLegacyUser")
  linkedStaffMember   StaffMember?
  reviewedStaffLeave  StaffLeave[]        @relation("StaffLeaveReviewedBy")
  recordedTimelineEntries TimelineEntry[] @relation("TimelineEntryRecordedBy")
  eventNotes          EventNote[]         @relation("EventNoteCreatedBy")
  completedChecklistItems EventChecklistItem[] @relation("EventChecklistItemCompletedBy")
  packedInventoryMovements InventoryMovement[] @relation("InventoryMovementPackedBy")
  inventoryVerifications   InventoryVerification[] @relation("InventoryVerificationVerifiedBy")
  uploadedFinancialDocuments FinancialDocument[] @relation("FinancialDocumentUploadedBy")
  verifiedFinancialDocuments FinancialDocument[] @relation("FinancialDocumentVerifiedBy")
  createdCommunicationRecords CommunicationRecord[] @relation("CommunicationRecordCreatedBy")
  assignedReminders Reminder[] @relation("ReminderAssignedTo")
  notificationPreferences NotificationPreference[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// R1-10 — Password history for reuse prevention (docs/14 §Password Requirements:
// "Password history — Prevent reuse of last 5 passwords"). One row per retired
// password hash; rows are only inserted (never mutated) and are compared against a
// new password using bcrypt, never plaintext. Tenant-scoped per ADR-016.
model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt])
  @@map("password_history")
}

// ADR-008 — Refresh-token session store (SessionRepository per docs/10 §Auth Module).
// One row per issued refresh token. Rotation revokes the presented row and creates a
// new one; logout / force-logout set `revokedAt`. Access tokens remain stateless (JWT);
// only refresh tokens are tracked here. tenant-scoped per ADR-016.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("sessions")
}

// R1-08 — Structured audit logging for sensitive business operations.
// docs/14-security-principles.md §Audit Logging (dedicated, immutable/append-only,
// tamper-evident table) + docs/10-implementation-specification.md §Audit Strategy
// (actor, tenantId, action, target aggregate ids, timestamp, outcome; before/after
// status summaries but no sensitive payloads — captured in `metadata`).
//
// Append-only: rows are only ever inserted, never updated or deleted (no `version`
// or `updated_at`). `actorId` is stored as a denormalized value (no FK to `users`)
// so audit history survives independently of user lifecycle and retention rules.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  outcome    String
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Sprint 1 — W5 Lead → Booking
// ---------------------------------------------------------------------------

enum CustomerStatus {
  active
  inactive
  blocked

  @@map("customer_status")
}

enum CustomerType {
  individual
  organization

  @@map("customer_type")
}

enum LeadSource {
  website
  instagram
  whatsapp
  referral
  walk_in
  phone
  manual
  other

  @@map("lead_source")
}

enum LeadStage {
  new
  in_talks
  approved
  completed
  lost
  cancelled

  @@map("lead_stage")
}

enum FollowUpStatus {
  pending
  done
  cancelled

  @@map("follow_up_status")
}

enum QuotationStatus {
  draft
  sent
  approved
  rejected
  expired
  superseded

  @@map("quotation_status")
}

enum EventStatus {
  approved
  in_preparation
  in_execution
  completed
  cancelled

  @@map("event_status")
}

enum PaymentMethod {
  upi
  cash
  bank_transfer
  card
  cheque
  other

  @@map("payment_method")
}

enum PaymentStatus {
  confirmed
  void

  @@map("payment_status")
}

enum PreparationStatus {
  pending
  ready
  needs_attention

  @@map("preparation_status")
}

enum WorkspaceStatus {
  inactive
  active
  archived

  @@map("workspace_status")
}

/// R3-05 / EP1-CUS-002 — Communication timeline entry type (`docs/09` POST body).
enum TimelineEntryType {
  note
  issue
  other

  @@map("timeline_entry_type")
}

model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  displayName  String         @map("display_name")
  type         CustomerType   @default(individual)
  status       CustomerStatus @default(active)
  primaryPhone String?        @map("primary_phone")
  primaryEmail String?        @map("primary_email")
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  version      Int            @default(1)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  leads           Lead[]
  quotations      Quotation[]
  events          Event[]
  invoices        Invoice[]
  timelineEntries TimelineEntry[]
  contacts        Contact[]
  issueNotes      IssueNote[]
  reviewRequests  ReviewRequest[]
  communicationRecords CommunicationRecord[]
  reminders Reminder[]
  notificationPreferences NotificationPreference[]

  @@unique([tenantId, displayName])
  @@index([tenantId, status])
  @@map("customers")
}

/// R3-06 / EP1-CUS-001 — Owned Contact entity under Customer (docs/07).
/// Physical table `contacts` per docs/06 + decision 1A. No version column.
model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  name       String
  role       String
  phone      String?
  email      String?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId, customerId])
  @@map("contacts")
}

/// R3-05 / EP1-CUS-002 — Per-event communication timeline (append-only).
/// Physical table `client_interactions` per docs/06 + decision 1B. No version column.
model TimelineEntry {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  eventId          String            @map("event_id") @db.Uuid
  type             TimelineEntryType
  message          String
  occurredAt       DateTime          @map("occurred_at")
  recordedByUserId String            @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  recordedBy User     @relation("TimelineEntryRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, eventId, createdAt])
  @@index([tenantId, customerId, occurredAt])
  @@map("client_interactions")
}

/// R3-07 / EP1-CUS-004 — Lightweight customer issue note per event (docs/07 Issue).
/// Create-only in Phase 1 (no resolve PATCH). Table `issue_notes`.
model IssueNote {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  eventId    String            @map("event_id") @db.Uuid
  customerId String            @map("customer_id") @db.Uuid
  message    String
  severity   IssueNoteSeverity @default(medium)
  notes      String?
  status     IssueNoteStatus   @default(open)
  createdAt  DateTime          @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId, eventId, createdAt])
  @@map("issue_notes")
}

/// R3-07 / EP1-CUS-003 — Review request per event (at most one; docs/07 Event ||--o| ReviewRequest).
/// Create-only in Phase 1. Table `review_requests`.
model ReviewRequest {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  eventId       String               @unique @map("event_id") @db.Uuid
  customerId    String               @map("customer_id") @db.Uuid
  channel       ReviewRequestChannel
  channelDetail String?              @map("channel_detail")
  status        ReviewRequestStatus  @default(pending)
  createdAt     DateTime             @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId, customerId])
  @@map("review_requests")
}

model Lead {
  id                      String     @id @default(uuid()) @db.Uuid
  tenantId                String     @map("tenant_id") @db.Uuid
  customerId              String?    @map("customer_id") @db.Uuid
  assignedToId            String?    @map("assigned_to_id") @db.Uuid
  source                  LeadSource
  sourceDetail            String?    @map("source_detail")
  stage                   LeadStage  @default(new)
  lostReason              String?    @map("lost_reason")
  eventType               String?    @map("event_type")
  eventStartDate          DateTime?  @map("event_start_date") @db.Date
  eventEndDate            DateTime?  @map("event_end_date") @db.Date
  venue                   String?
  estimatedBudgetAmount   Decimal?   @map("estimated_budget_amount") @db.Decimal(12, 2)
  estimatedBudgetCurrency String     @default("INR") @map("estimated_budget_currency")
  guestCount              Int?       @map("guest_count")
  notes                   String?
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")
  version                 Int        @default(1)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer      Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedTo    User?              @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  event         Event?
  followUps     FollowUp[]
  stageHistory  LeadStageHistory[]
  quotations    Quotation[]

  @@index([tenantId, stage])
  @@index([tenantId, assignedToId])
  @@index([tenantId, source])
  @@index([tenantId, customerId])
  @@map("leads")
}

model LeadStageHistory {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  leadId      String     @map("lead_id") @db.Uuid
  fromStage   LeadStage? @map("from_stage")
  toStage     LeadStage  @map("to_stage")
  reason      String?
  changedById String?    @map("changed_by_id") @db.Uuid
  changedAt   DateTime   @default(now()) @map("changed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy User? @relation("LeadStageChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([tenantId, leadId])
  @@index([leadId, changedAt])
  @@map("lead_stage_history")
}

model FollowUp {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  leadId    String         @map("lead_id") @db.Uuid
  dueAt     DateTime       @map("due_at")
  notes     String?
  status    FollowUpStatus @default(pending)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  version   Int            @default(1)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
  @@index([tenantId, status, dueAt])
  @@map("follow_ups")
}

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  leadId          String?         @map("lead_id") @db.Uuid
  quotationNumber Int             @map("quotation_number")
  revisionNumber  Int             @default(1) @map("revision_number")
  status          QuotationStatus @default(draft)
  eventType       String?         @map("event_type")
  eventStartDate  DateTime?       @map("event_start_date") @db.Date
  eventEndDate    DateTime?       @map("event_end_date") @db.Date
  venue           String?
  validUntil      DateTime?       @map("valid_until") @db.Date
  terms           String?
  notes           String?
  subtotalAmount  Decimal         @default(0) @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount       Decimal         @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0) @map("total_amount") @db.Decimal(12, 2)
  currency        String          @default("INR")
  supersededById  String?         @unique @map("superseded_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  version         Int             @default(1)

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  event      Event?
  superseded Quotation? @relation("QuotationRevision", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes Quotation? @relation("QuotationRevision")
  lineItems  QuotationLineItem[]

  @@unique([tenantId, quotationNumber, revisionNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, leadId])
  @@map("quotations")
}

/// Unified event record (Booking module). Maps to domain aggregate "Event".
model Event {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  customerId          String            @map("customer_id") @db.Uuid
  leadId              String?           @unique @map("lead_id") @db.Uuid
  quotationId         String            @unique @map("quotation_id") @db.Uuid
  bookingNumber       Int               @map("booking_number")
  status              EventStatus       @default(approved)
  eventType           String?           @map("event_type")
  eventStartDate      DateTime?         @map("event_start_date") @db.Date
  eventEndDate        DateTime?         @map("event_end_date") @db.Date
  venueName           String?           @map("venue_name")
  guestCount          Int?              @map("guest_count")
  requirementsNotes   String?           @map("requirements_notes")
  workspaceStatus     WorkspaceStatus   @default(inactive) @map("workspace_status")
  preparationStatus   PreparationStatus @default(pending) @map("preparation_status")
  operationalMilestone String?          @map("operational_milestone")
  executionOwnerId    String?           @map("execution_owner_id") @db.Uuid
  cancellationReason  String?           @map("cancellation_reason")
  completedAt         DateTime?         @map("completed_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  version             Int               @default(1)

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  executionOwner User?     @relation("EventExecutionOwner", fields: [executionOwnerId], references: [id], onDelete: SetNull)
  payments       Payment[]
  tasks          Task[]
  staffAssignments StaffAssignment[]
  inventoryMovements InventoryMovement[]
  inventoryReservations InventoryReservation[]
  inventoryVerifications InventoryVerification[]
  inventoryDamageReports InventoryDamageReport[]
  vendorProcurements VendorProcurement[]
  procurementLines   ProcurementLine[]
  procurementTimelineEvents ProcurementTimelineEvent[]
  invoices           Invoice[]
  vendorExpenses     VendorExpense[]
  financialDocuments FinancialDocument[]
  communicationRecords CommunicationRecord[]
  reminders Reminder[]
  timelineEntries    TimelineEntry[]
  issueNotes         IssueNote[]
  reviewRequest      ReviewRequest?
  eventNotes         EventNote[]
  eventChecklists    EventChecklist[]

  @@unique([tenantId, bookingNumber])
  @@index([tenantId, status, eventStartDate])
  @@index([tenantId, executionOwnerId])
  @@index([tenantId, customerId])
  @@map("events")
}

// ---------------------------------------------------------------------------
// Sprint 1 — Payment (EP1-BR-001 advance gating)
// ---------------------------------------------------------------------------

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  bookingId          String?       @map("booking_id") @db.Uuid
  leadId             String?       @map("lead_id") @db.Uuid
  quotationId        String?       @map("quotation_id") @db.Uuid
  invoiceId          String?       @map("invoice_id") @db.Uuid
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @default("INR")
  method             PaymentMethod
  status             PaymentStatus @default(confirmed)
  receivedAt         DateTime      @map("received_at")
  attachmentId       String?       @map("attachment_id") @db.Uuid
  missingProofReason String?       @map("missing_proof_reason")
  notes              String?
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  version            Int           @default(1)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking Event?   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  financialDocuments FinancialDocument[]

  @@index([tenantId, bookingId])
  @@index([tenantId, leadId])
  @@index([tenantId, quotationId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Sprint 1 — Quotation Line Items
// ---------------------------------------------------------------------------

model QuotationLineItem {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  quotationId   String   @map("quotation_id") @db.Uuid
  description   String
  quantity      Int      @default(1)
  unitPriceAmount Decimal @map("unit_price_amount") @db.Decimal(12, 2)
  currency      String   @default("INR")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  version       Int      @default(1)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  procurementLines ProcurementLine[]

  @@index([tenantId, quotationId])
  @@map("quotation_line_items")
}

// ---------------------------------------------------------------------------
// Sprint 2B — Task Management (EP1-OPS-003, EP1-AUT-003)
// ---------------------------------------------------------------------------

enum TaskStatus {
  pending
  in_progress
  completed
  cancelled

  @@map("task_status")
}

/// P2-01 — Operational task category (checklist grouping via category).
enum TaskCategory {
  general
  pre_event
  dayheets
  vendor
  inventory
  venue
  wrap_up

  @@map("task_category")
}

/// P2-01 — Operational task priority.
enum TaskPriority {
  low
  medium
  high
  urgent

  @@map("task_priority")
}

/// Event-linked execution checklist / operational task (Task module, `07-domain-model.md` §Task).
model Task {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  bookingId       String       @map("booking_id") @db.Uuid
  title           String
  description     String?
  category        TaskCategory @default(general)
  priority        TaskPriority @default(medium)
  assignedTo      String?      @map("assigned_to") @db.Uuid
  dueAt           DateTime?    @map("due_at")
  status          TaskStatus   @default(pending)
  completedAt     DateTime?    @map("completed_at")
  completionNotes String?      @map("completion_notes")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  version         Int          @default(1)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking        Event           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  checklistItems ChecklistItem[]

  @@index([tenantId, bookingId])
  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@index([tenantId, category])
  @@map("tasks")
}

