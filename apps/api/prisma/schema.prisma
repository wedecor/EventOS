enum VendorExpenseStatus {
  confirmed
  void

  @@map("vendor_expense_status")
}

// Per `07-domain-model.md` §Invoice: "draft → sent → partially_paid → paid → void". Phase 1 API
// design (`09-api-design.md` §Module: Finance) only exposes `send`/`void` commands — `partially_paid`
// and `paid` are reserved for a future automatic recalculation from linked payments (see
// implementation report: documented risk "avoid auto-financial calculations that assume missing
// data"). The enum values are included for domain-model completeness/traceability even though no
// Phase 1 command transitions into them yet.
enum InvoiceStatus {
  draft
  sent
  partially_paid
  paid
  void

  @@map("invoice_status")
}

/// Vendor and event expenses for profitability (`07-domain-model.md` §VendorExpense, EP1-FIN-004).
/// `procurementLineId` is a real FK (unlike `InventoryMovement.inventoryItemId`) because
/// `ProcurementLine` already exists from Sprint 4 — mirrors `ProcurementLine.quotationLineItemId`.
/// `attachmentId` is stored as a plain identifier (no FK), matching the deferred `Payment.attachmentId`
/// pattern, because the `Attachment` aggregate (EP1-FIN-003/INV-007/MKT-003) is out of scope.
model VendorExpense {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  bookingId         String              @map("booking_id") @db.Uuid
  vendorId          String              @map("vendor_id") @db.Uuid
  procurementLineId String?             @map("procurement_line_id") @db.Uuid
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("INR")
  method            PaymentMethod
  status            VendorExpenseStatus @default(confirmed)
  paidAt            DateTime            @map("paid_at")
  attachmentId      String?             @map("attachment_id") @db.Uuid
  notes             String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  version           Int                 @default(1)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking         Event            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  procurementLine ProcurementLine? @relation(fields: [procurementLineId], references: [id], onDelete: SetNull)
  financialDocuments FinancialDocument[]

  @@index([tenantId, bookingId])
  @@index([tenantId, vendorId])
  @@index([tenantId, status])
  @@map("vendor_expenses")
}

/// Event-linked billing and invoices (`07-domain-model.md` §Invoice, EP1-FIN-002). `invoiceNumber`
/// is a tenant-scoped display sequence, matching `Event.bookingNumber` / `Quotation.quotationNumber`.
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  bookingId      String        @map("booking_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  invoiceNumber  Int           @map("invoice_number")
  status         InvoiceStatus @default(draft)
  subtotalAmount Decimal       @default(0) @map("subtotal_amount") @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  currency       String        @default("INR")
  notes          String?
  sentAt         DateTime?     @map("sent_at")
  voidedAt       DateTime?     @map("voided_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  version        Int           @default(1)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking   Event               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  customer  Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lineItems InvoiceLineItem[]
  payments  Payment[]
  financialDocuments FinancialDocument[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, bookingId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("invoices")
}

/// Billed line under an Invoice (`07-domain-model.md` §Invoice — InvoiceLineItem entity,
/// EP1-FIN-002). Mirrors `QuotationLineItem` exactly (same owned-entity shape and lifecycle).
model InvoiceLineItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  invoiceId       String   @map("invoice_id") @db.Uuid
  description     String
  quantity        Int      @default(1)
  unitPriceAmount Decimal  @map("unit_price_amount") @db.Decimal(12, 2)
  currency        String   @default("INR")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  version         Int      @default(1)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@map("invoice_line_items")
}

