  @@index([tenantId, category])
  @@map("vendors")
}

/// Vendor-level feedback note (`07-domain-model.md` §Vendor — VendorIssueNote entity, EP1-VEN-006).
/// Append-only, matching the `InventoryMovementDamageNote` precedent.
model VendorIssueNote {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  vendorId   String             @map("vendor_id") @db.Uuid
  message    String
  severity   IssueNoteSeverity  @default(medium)
  occurredAt DateTime?          @map("occurred_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([tenantId, vendorId])
  @@map("vendor_issue_notes")
}

/// Procurement header per event-vendor pairing (`07-domain-model.md` §Vendor Procurement AR,
/// EP1-VEN-002). `status` mirrors Phase 1 line enum for backward-compatible clients.
/// P2-06 adds `workflowStatus` as the operational lifecycle source of truth.
model VendorProcurement {
  id              String                           @id @default(uuid()) @db.Uuid
  tenantId        String                           @map("tenant_id") @db.Uuid
  bookingId       String                           @map("booking_id") @db.Uuid
  vendorId        String                           @map("vendor_id") @db.Uuid
  /// Legacy Phase 1 summary status (synced from workflowStatus for backward compatibility).
  status          ProcurementLineStatus            @default(planned)
  /// P2-06 operational workflow status.
  workflowStatus  VendorProcurementWorkflowStatus  @default(draft) @map("workflow_status")
  serviceCategory String?                          @map("service_category")
  requiredDate    DateTime?                        @map("required_date") @db.Date
  estimatedCost   Decimal?                         @map("estimated_cost") @db.Decimal(12, 2)
  approvedCost    Decimal?                         @map("approved_cost") @db.Decimal(12, 2)
  actualCost      Decimal?                         @map("actual_cost") @db.Decimal(12, 2)
  deliveryStatus  ProcurementDeliveryStatus        @default(pending) @map("delivery_status")
  deliveryNotes   String?                          @map("delivery_notes")
  notes           String?
  createdAt       DateTime                         @default(now()) @map("created_at")
  updatedAt       DateTime                         @updatedAt @map("updated_at")
  version         Int                              @default(1)

  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking        Event                       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  vendor         Vendor                      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines          ProcurementLine[]
  quotes         ProcurementQuote[]
  purchaseOrders PurchaseOrder[]
  timelineEvents ProcurementTimelineEvent[]
  inventoryReservations InventoryReservation[]
  financialDocuments FinancialDocument[]

  @@index([tenantId, bookingId])
  @@index([tenantId, vendorId])
  @@index([tenantId, workflowStatus])
  @@map("vendor_procurements")
}

/// P2-06 — Vendor quotation against a procurement header (multiple allowed; one may be approved).
model ProcurementQuote {
  id                 String                 @id @default(uuid()) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  vendorProcurementId String                @map("vendor_procurement_id") @db.Uuid
  vendorId           String                 @map("vendor_id") @db.Uuid
  amount             Decimal                @db.Decimal(12, 2)
  currency           String                 @default("INR")
  validUntil         DateTime?              @map("valid_until") @db.Date
  notes              String?
  /// Attachment metadata only — file storage deferred (no PDF/binary in P2-06).
  attachmentName     String?                @map("attachment_name")
  attachmentMimeType String?                @map("attachment_mime_type")
  attachmentSizeBytes Int?                  @map("attachment_size_bytes")
  status             ProcurementQuoteStatus @default(submitted)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  version            Int                    @default(1)

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vendorProcurement  VendorProcurement @relation(fields: [vendorProcurementId], references: [id], onDelete: Cascade)
  vendor             Vendor            @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@index([tenantId, vendorProcurementId])
  @@index([tenantId, vendorId])
  @@map("procurement_quotes")
}

/// P2-06 — Purchase order generated from an approved procurement (PDF deferred).
model PurchaseOrder {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  vendorProcurementId String             @map("vendor_procurement_id") @db.Uuid
  vendorId            String             @map("vendor_id") @db.Uuid
  poNumber            String             @map("po_number")
  issueDate           DateTime           @map("issue_date") @db.Date
  totalAmount         Decimal            @map("total_amount") @db.Decimal(12, 2)
  currency            String             @default("INR")
  notes               String?
  status              PurchaseOrderStatus @default(draft)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  version             Int                @default(1)

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vendorProcurement VendorProcurement @relation(fields: [vendorProcurementId], references: [id], onDelete: Cascade)
  vendor            Vendor            @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([tenantId, poNumber])
  @@index([tenantId, vendorProcurementId])
  @@map("purchase_orders")
}

/// P2-06 — Append-only procurement timeline for workspace activity integration.
model ProcurementTimelineEvent {
  id                  String                       @id @default(uuid()) @db.Uuid
  tenantId            String                       @map("tenant_id") @db.Uuid
  vendorProcurementId String                       @map("vendor_procurement_id") @db.Uuid
  bookingId           String                       @map("booking_id") @db.Uuid
  eventType           ProcurementTimelineEventType @map("event_type")
  message             String
  occurredAt          DateTime                     @map("occurred_at")
  createdAt           DateTime                     @default(now()) @map("created_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vendorProcurement VendorProcurement @relation(fields: [vendorProcurementId], references: [id], onDelete: Cascade)
  booking           Event             @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([tenantId, vendorProcurementId, occurredAt])
  @@index([tenantId, bookingId, occurredAt])
  @@map("procurement_timeline_events")
}

/// Procurement line item (`07-domain-model.md` §Vendor Procurement — ProcurementLine entity,
/// EP1-VEN-002/003/005). `bookingId` is denormalized onto the line per `08-data-model.md`
/// §Procurement Persistence ("Each ProcurementLine stores: event_id, vendor_procurement_id,
/// optional quotation_line_item_id"). `quotationLineItemId` is a real FK (unlike
/// `InventoryMovement.inventoryItemId`) because `QuotationLineItem` already exists from Sprint 1.
model ProcurementLine {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  vendorProcurementId String              @map("vendor_procurement_id") @db.Uuid
  bookingId           String              @map("booking_id") @db.Uuid
  quotationLineItemId String?             @map("quotation_line_item_id") @db.Uuid
  description         String
  category            String
  quantity            Int                 @default(1)
  budgetedAmount      Decimal?            @map("budgeted_amount") @db.Decimal(12, 2)
  actualAmount        Decimal?            @map("actual_amount") @db.Decimal(12, 2)
  currency            String              @default("INR")
  status              ProcurementLineStatus @default(planned)
  requestedAt         DateTime?           @map("requested_at")
  confirmedAt         DateTime?           @map("confirmed_at")
  deliveredAt         DateTime?           @map("delivered_at")
  completedAt         DateTime?           @map("completed_at")
  costVarianceAmount  Decimal?            @map("cost_variance_amount") @db.Decimal(12, 2)
  costVarianceReason  CostVarianceReason? @map("cost_variance_reason")
  notes               String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  version             Int                 @default(1)

  vendorProcurement VendorProcurement          @relation(fields: [vendorProcurementId], references: [id], onDelete: Restrict)
  booking           Event                      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  quotationLineItem QuotationLineItem?         @relation(fields: [quotationLineItemId], references: [id], onDelete: SetNull)
  issueNotes        ProcurementLineIssueNote[]
  vendorExpenses    VendorExpense[]

  @@index([tenantId, vendorProcurementId])
  @@index([tenantId, bookingId, status])
  @@map("procurement_lines")
}

/// Line-level issue note (`07-domain-model.md` §Vendor Procurement — ProcurementLineIssueNote
/// entity, EP1-VEN-006). Append-only, matching the `InventoryMovementDamageNote` precedent.
model ProcurementLineIssueNote {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  procurementLineId String            @map("procurement_line_id") @db.Uuid
  message           String
  severity          IssueNoteSeverity @default(medium)
  occurredAt        DateTime?         @map("occurred_at")
  createdAt         DateTime          @default(now()) @map("created_at")

  procurementLine ProcurementLine @relation(fields: [procurementLineId], references: [id], onDelete: Cascade)

  @@index([tenantId, procurementLineId])
  @@map("procurement_line_issue_notes")
}

