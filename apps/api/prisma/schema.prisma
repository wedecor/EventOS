enum StaffMemberStatus {
  active
  inactive
  on_leave

  @@map("staff_member_status")
}

enum StaffEmploymentType {
  permanent
  temporary

  @@map("staff_employment_type")
}

/// Staff master profile (`07-domain-model.md` §StaffMember, P2-03/P2-04).
/// Operational workforce identity. Optional `userId` links to Auth User without
/// duplicating authentication. StaffAssignment references this aggregate.
model StaffMember {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  /// Optional auth link — User remains authentication boundary only.
  userId           String?             @unique @map("user_id") @db.Uuid
  name             String
  /// Operational role (decorator / coordinator / helper, etc.).
  role             String
  department       String?
  phone            String
  email            String?
  employmentType   StaffEmploymentType @default(temporary) @map("employment_type")
  status           StaffMemberStatus   @default(active)
  joinedAt         DateTime?           @map("joined_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  version          Int                 @default(1)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments StaffAssignment[]
  availability StaffAvailability[]
  leaveRequests StaffLeave[]
  communicationRecords CommunicationRecord[]
  reminders Reminder[]

  @@index([tenantId, status])
  @@index([tenantId, employmentType])
  @@map("staff_members")
}

// ---------------------------------------------------------------------------
// P2-05 — Staff Availability & Leave (scheduling owned by StaffMember)
// ---------------------------------------------------------------------------

enum StaffAvailabilityKind {
  available
  unavailable
  partial_day
  holiday

  @@map("staff_availability_kind")
}

/// Date-specific or weekly recurring availability window for a StaffMember.
model StaffAvailability {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  staffMemberId String                @map("staff_member_id") @db.Uuid
  /// Specific calendar day (null when weekday recurrence is used).
  date          DateTime?             @db.Date
  /// Recurring weekly day 0=Sunday … 6=Saturday (null when date-specific).
  weekday       Int?
  /// Optional time window "HH:mm" (null = all-day).
  startTime     String?               @map("start_time")
  endTime       String?               @map("end_time")
  kind          StaffAvailabilityKind @default(available)
  reason        String?
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  version       Int                   @default(1)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffMemberId, date])
  @@index([tenantId, staffMemberId, weekday])
  @@map("staff_availability")
}

enum StaffLeaveType {
  casual
  sick
  vacation
  emergency
  other

  @@map("staff_leave_type")
}

enum StaffLeaveStatus {
  requested
  approved
  rejected
  cancelled

  @@map("staff_leave_status")
}

/// Leave request for a StaffMember. Approved leave blocks availability for conflict checks.
model StaffLeave {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  staffMemberId   String           @map("staff_member_id") @db.Uuid
  leaveType       StaffLeaveType   @map("leave_type")
  status          StaffLeaveStatus @default(requested)
  startDate       DateTime         @map("start_date") @db.Date
  endDate         DateTime         @map("end_date") @db.Date
  reason          String?
  notes           String?
  reviewedByUserId String?         @map("reviewed_by_user_id") @db.Uuid
  reviewedAt      DateTime?        @map("reviewed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  version         Int              @default(1)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("StaffLeaveReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, staffMemberId, status])
  @@index([tenantId, startDate, endDate])
  @@map("staff_leave")
}

// ---------------------------------------------------------------------------
// Sprint 2C — Staff Assignment (EP1-STF-002, EP1-AUT-004)
// ---------------------------------------------------------------------------

enum StaffAssignmentStatus {
  proposed
  confirmed
  released
  cancelled

  @@map("staff_assignment_status")
}

/// Staff member assigned to an event (Staff module, `07-domain-model.md` §Staff Assignment).
/// P2-04: `staffMemberId` references StaffMember (operational identity).
/// `legacyUserId` preserves pre-P2-04 User FK values during expand-contract (Phase 3 drop later).
model StaffAssignment {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  bookingId          String                @map("booking_id") @db.Uuid
  staffMemberId      String                @map("staff_member_id") @db.Uuid
  /// Expand-contract: previous User identity; nullable after backfill; drop in Phase 3.
  legacyUserId       String?               @map("legacy_user_id") @db.Uuid
  role               String?
  isOnSiteLead       Boolean               @default(false) @map("is_on_site_lead")
  reportingAt        DateTime?             @map("reporting_at")
  note               String?
  status             StaffAssignmentStatus @default(proposed)
  confirmedAt        DateTime?             @map("confirmed_at")
  releasedAt         DateTime?             @map("released_at")
  cancelledAt        DateTime?             @map("cancelled_at")
  cancellationReason String?               @map("cancellation_reason")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  version            Int                   @default(1)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking     Event       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)
  legacyUser  User?       @relation("StaffAssignmentLegacyUser", fields: [legacyUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, bookingId])
  @@index([tenantId, staffMemberId])
  @@index([tenantId, status])
  @@index([tenantId, legacyUserId])
  @@map("staff_assignments")
}

// ---------------------------------------------------------------------------
// R3-02 — Inventory Item Master (EP1-INV-001, EP1-INV-002)
// ---------------------------------------------------------------------------

enum InventoryItemTaxonomy {
  reusable
  consumable
  per_event

  @@map("inventory_item_taxonomy")
}

enum InventoryItemCondition {
  good
  fair
  damaged
  retired

  @@map("inventory_item_condition")
}

enum InventoryItemStatus {
  active
  inactive
  retired

  @@map("inventory_item_status")
}

/// Inventory master (`07-domain-model.md` §InventoryItem, docs/09 §Inventory).
/// `quantityAtJpNagar` is Phase 1 denormalized LocationQuantity (R3-02 decision 3A).
/// P2-07: available qty = quantityAtJpNagar − active reservations − unlinked active movements.
model InventoryItem {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  name              String
  sku               String?
  category          String
  taxonomy          InventoryItemTaxonomy
  unit              String
  condition         InventoryItemCondition @default(good)
  quantityAtJpNagar Int                    @default(0) @map("quantity_at_jp_nagar")
  status            InventoryItemStatus    @default(active)
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  version           Int                    @default(1)

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reservations  InventoryReservation[]
  damageReports InventoryDamageReport[]

  @@index([tenantId, status])
  @@index([tenantId, taxonomy])
  @@index([tenantId, category])
  @@map("inventory_items")
}

// ---------------------------------------------------------------------------
// Sprint 3 — Inventory Movement (EP1-INV-003, EP1-INV-005, EP1-INV-006)
// P2-07 — Expanded operational statuses + packing/dispatch/return fields
// ---------------------------------------------------------------------------

enum InventoryMovementStatus {
  planned
  picked
  packing_started
  packed
  verified
  ready_for_dispatch
  loaded
  dispatched
  at_venue
  returned
  return_verified
  cleaned_ready
  cancelled

  @@map("inventory_movement_status")
}

enum InventoryReservationStatus {
  reserved
  released
  cancelled

  @@map("inventory_reservation_status")
}

enum InventoryVerificationResult {
  pass
  fail
  partial

  @@map("inventory_verification_result")
}

enum InventoryDamageType {
  breakage
  loss
  water_damage
  wear
  other

  @@map("inventory_damage_type")
}

enum InventoryDamageSeverity {
  low
  medium
  high
  critical

  @@map("inventory_damage_severity")
}

/// P2-07 — Booking-scoped reservation that holds available quantity.
model InventoryReservation {
  id                  String                      @id @default(uuid()) @db.Uuid
  tenantId            String                      @map("tenant_id") @db.Uuid
  bookingId           String                      @map("booking_id") @db.Uuid
  inventoryItemId     String                      @map("inventory_item_id") @db.Uuid
  quantity            Int                         @default(1)
  status              InventoryReservationStatus  @default(reserved)
  notes               String?
  /// Optional link to a completed vendor procurement (no duplicate purchasing).
  vendorProcurementId String?                     @map("vendor_procurement_id") @db.Uuid
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  version             Int                         @default(1)

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking           Event                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  inventoryItem     InventoryItem        @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  vendorProcurement VendorProcurement?   @relation(fields: [vendorProcurementId], references: [id], onDelete: SetNull)
  movements         InventoryMovement[]

  @@index([tenantId, bookingId])
  @@index([tenantId, inventoryItemId, status])
  @@map("inventory_reservations")
}

/// Per-event stock movement through preparation and return (`07-domain-model.md` §Inventory
/// Movement, `docs/business/08-inventory-workflow.md` §11). P2-07 adds packing/dispatch/return
/// operational fields and optional reservation link. FK to InventoryItem added in P2-07.
model InventoryMovement {
  id                  String                  @id @default(uuid()) @db.Uuid
  tenantId            String                  @map("tenant_id") @db.Uuid
  bookingId           String                  @map("booking_id") @db.Uuid
  inventoryItemId     String                  @map("inventory_item_id") @db.Uuid
  reservationId       String?                 @map("reservation_id") @db.Uuid
  quantity            Int                     @default(1)
  notes               String?
  status              InventoryMovementStatus @default(planned)
  /// Packing
  packedByUserId      String?                 @map("packed_by_user_id") @db.Uuid
  packingStartedAt    DateTime?               @map("packing_started_at")
  verificationNotes   String?                 @map("verification_notes")
  verifiedAt          DateTime?               @map("verified_at")
  readyForDispatchAt  DateTime?               @map("ready_for_dispatch_at")
  /// Dispatch
  vehicle             String?
  driverName          String?                 @map("driver_name")
  dispatchedAt        DateTime?               @map("dispatched_at")
  /// Return
  returnedQuantity    Int?                    @map("returned_quantity")
  missingQuantity     Int?                    @map("missing_quantity")
  damagedQuantity     Int?                    @map("damaged_quantity")
  returnVerificationNotes String?             @map("return_verification_notes")
  returnVerifiedAt    DateTime?               @map("return_verified_at")
  /// Phase 1 timestamps
  pickedAt            DateTime?               @map("picked_at")
  packedAt            DateTime?               @map("packed_at")
  loadedAt            DateTime?               @map("loaded_at")
  atVenueAt           DateTime?               @map("at_venue_at")
  returnedAt          DateTime?               @map("returned_at")
  cleanedReadyAt      DateTime?               @map("cleaned_ready_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  version             Int                     @default(1)

  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking       Event                         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  reservation   InventoryReservation?         @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  packedBy      User?                         @relation("InventoryMovementPackedBy", fields: [packedByUserId], references: [id], onDelete: SetNull)
  damageNotes   InventoryMovementDamageNote[]
  verifications InventoryVerification[]
  damageReports InventoryDamageReport[]

  @@index([tenantId, bookingId, status])
  @@index([tenantId, inventoryItemId, status])
  @@index([tenantId, reservationId])
  @@map("inventory_movements")
}

/// Accountability note for damage/loss on a movement (`EP1-INV-006`). Append-only — no update or
/// delete endpoint is documented, matching the `LeadStageHistory` immutable-log pattern.
model InventoryMovementDamageNote {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  movementId     String    @map("movement_id") @db.Uuid
  message        String
  accountability String?
  occurredAt     DateTime? @map("occurred_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  movement InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@index([tenantId, movementId])
  @@map("inventory_movement_damage_notes")
}

/// P2-07 — Structured expected vs actual verification for a movement.
model InventoryVerification {
  id               String                       @id @default(uuid()) @db.Uuid
  tenantId         String                       @map("tenant_id") @db.Uuid
  movementId       String                       @map("movement_id") @db.Uuid
  bookingId        String                       @map("booking_id") @db.Uuid
  expectedQuantity Int                          @map("expected_quantity")
  actualQuantity   Int                          @map("actual_quantity")
  difference       Int
  result           InventoryVerificationResult
  notes            String?
  verifiedAt       DateTime                     @map("verified_at")
  verifiedByUserId String?                      @map("verified_by_user_id") @db.Uuid
  createdAt        DateTime                     @default(now()) @map("created_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  movement InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  booking  Event             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  verifiedBy User?           @relation("InventoryVerificationVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, movementId])
  @@index([tenantId, bookingId])
  @@map("inventory_verifications")
}

/// P2-07 — Structured damage report (photo metadata only; no image storage).
model InventoryDamageReport {
  id                 String                   @id @default(uuid()) @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  movementId         String                   @map("movement_id") @db.Uuid
  bookingId          String                   @map("booking_id") @db.Uuid
  inventoryItemId    String?                  @map("inventory_item_id") @db.Uuid
  damageType         InventoryDamageType      @map("damage_type")
  severity           InventoryDamageSeverity  @default(medium)
  quantity           Int                      @default(1)
  notes              String?
  photoName          String?                  @map("photo_name")
  photoMimeType      String?                  @map("photo_mime_type")
  photoSizeBytes     Int?                     @map("photo_size_bytes")
  createdAt          DateTime                 @default(now()) @map("created_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  movement      InventoryMovement  @relation(fields: [movementId], references: [id], onDelete: Cascade)
  booking       Event              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem?     @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([tenantId, movementId])
  @@index([tenantId, bookingId])
  @@map("inventory_damage_reports")
}

