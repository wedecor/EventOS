  bookingId        String?                 @map("booking_id") @db.Uuid
  customerId       String?                 @map("customer_id") @db.Uuid
  vendorId         String?                 @map("vendor_id") @db.Uuid
  staffMemberId    String?                 @map("staff_member_id") @db.Uuid
  templateId       String?                 @map("template_id") @db.Uuid
  channel          CommunicationChannel
  direction        CommunicationDirection
  status           CommunicationStatus     @default(draft)
  subject          String?
  body             String?
  failureReason    String?                 @map("failure_reason")
  createdByUserId  String?                 @map("created_by_user_id") @db.Uuid
  occurredAt       DateTime                @default(now()) @map("occurred_at")
  sentAt           DateTime?               @map("sent_at")
  deliveredAt      DateTime?               @map("delivered_at")
  readAt           DateTime?               @map("read_at")
  failedAt         DateTime?               @map("failed_at")
  deletedAt        DateTime?               @map("deleted_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  version          Int                     @default(1)

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking     Event?                   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer    Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vendor      Vendor?                  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  staffMember StaffMember?             @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  template    CommunicationTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy   User?                    @relation("CommunicationRecordCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attachments CommunicationAttachment[]
  reminders   Reminder[]

  @@index([tenantId, bookingId, occurredAt])
  @@index([tenantId, customerId, occurredAt])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, channel])
  @@map("communication_records")
}

model CommunicationTemplate {
  id         String                       @id @default(uuid()) @db.Uuid
  tenantId   String                       @map("tenant_id") @db.Uuid
  name       String
  category   String
  channel    CommunicationChannel?
  subject    String?
  body       String
  status     CommunicationTemplateStatus  @default(active)
  createdAt  DateTime                     @default(now()) @map("created_at")
  updatedAt  DateTime                     @updatedAt @map("updated_at")
  version    Int                          @default(1)

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  records CommunicationRecord[]

  @@index([tenantId, status])
  @@index([tenantId, category])
  @@map("communication_templates")
}

/// Metadata-only attachment on a communication (same approach as FinancialDocument).
model CommunicationAttachment {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  communicationRecordId String    @map("communication_record_id") @db.Uuid
  fileName              String?   @map("file_name")
  mimeType              String?   @map("mime_type")
  fileSizeBytes         Int?      @map("file_size_bytes")
  storageKey            String?   @map("storage_key")
  deletedAt             DateTime? @map("deleted_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  version               Int       @default(1)

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  record CommunicationRecord @relation(fields: [communicationRecordId], references: [id], onDelete: Cascade)

  @@index([tenantId, communicationRecordId, deletedAt])
  @@map("communication_attachments")
}

/// Manual reminder / follow-up (no background scheduler in P2-09).
model Reminder {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @map("tenant_id") @db.Uuid
  bookingId             String?          @map("booking_id") @db.Uuid
  customerId            String?          @map("customer_id") @db.Uuid
  vendorId              String?          @map("vendor_id") @db.Uuid
  staffMemberId         String?          @map("staff_member_id") @db.Uuid
  communicationRecordId String?          @map("communication_record_id") @db.Uuid
  category              ReminderCategory @default(other)
  title                 String
  notes                 String?
  dueAt                 DateTime         @map("due_at")
  status                ReminderStatus   @default(pending)
  assignedToUserId      String?          @map("assigned_to_user_id") @db.Uuid
  completedAt           DateTime?        @map("completed_at")
  cancelledAt           DateTime?        @map("cancelled_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  version               Int              @default(1)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking     Event?               @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer    Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vendor      Vendor?              @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  staffMember StaffMember?         @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  communicationRecord CommunicationRecord? @relation(fields: [communicationRecordId], references: [id], onDelete: SetNull)
  assignedTo  User?                @relation("ReminderAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, dueAt])
  @@index([tenantId, bookingId, dueAt])
  @@index([tenantId, assignedToUserId, status])
  @@map("reminders")
}

/// Future-ready customer notification preferences (no delivery in P2-09).
model NotificationPreference {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  whatsapp   Boolean  @default(true)
  email      Boolean  @default(true)
  sms        Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  version    Int      @default(1)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([tenantId, userId])
  @@map("notification_preferences")
}

