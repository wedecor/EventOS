/// Booking-owned financial evidence metadata (`docs/07` §Attachment strategy, P2-08).
/// Binary upload / PDF generation remain out of scope — `storageKey` is metadata only.
model FinancialDocument {
  id                     String                                 @id @default(uuid()) @db.Uuid
  tenantId               String                                 @map("tenant_id") @db.Uuid
  bookingId              String                                 @map("booking_id") @db.Uuid
  documentType           FinancialDocumentType                  @map("document_type")
  verificationStatus     FinancialDocumentVerificationStatus    @default(pending) @map("verification_status")
  description            String?
  /// Attachment metadata only
  fileName               String?                                @map("file_name")
  mimeType               String?                                @map("mime_type")
  fileSizeBytes          Int?                                   @map("file_size_bytes")
  storageKey             String?                                @map("storage_key")
  /// Optional links (booking is always required)
  paymentId              String?                                @map("payment_id") @db.Uuid
  vendorExpenseId        String?                                @map("vendor_expense_id") @db.Uuid
  vendorProcurementId    String?                                @map("vendor_procurement_id") @db.Uuid
  invoiceId              String?                                @map("invoice_id") @db.Uuid
  uploadedByUserId       String?                                @map("uploaded_by_user_id") @db.Uuid
  uploadedAt             DateTime                               @default(now()) @map("uploaded_at")
  verifiedByUserId       String?                                @map("verified_by_user_id") @db.Uuid
  verifiedAt             DateTime?                              @map("verified_at")
  verificationNotes      String?                                @map("verification_notes")
  deletedAt              DateTime?                              @map("deleted_at")
  createdAt              DateTime                               @default(now()) @map("created_at")
  updatedAt              DateTime                               @updatedAt @map("updated_at")
  version                Int                                    @default(1)

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking           Event               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment           Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  vendorExpense     VendorExpense?      @relation(fields: [vendorExpenseId], references: [id], onDelete: SetNull)
  vendorProcurement VendorProcurement?  @relation(fields: [vendorProcurementId], references: [id], onDelete: SetNull)
  invoice           Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  uploadedBy        User?               @relation("FinancialDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  verifiedBy        User?               @relation("FinancialDocumentVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  auditEvents       FinancialDocumentAuditEvent[]

  @@index([tenantId, bookingId, deletedAt])
  @@index([tenantId, paymentId])
  @@index([tenantId, vendorExpenseId])
  @@index([tenantId, vendorProcurementId])
  @@index([tenantId, verificationStatus])
  @@map("financial_documents")
}

/// Append-only audit trail for financial document lifecycle (P2-08).
model FinancialDocumentAuditEvent {
  id                  String                           @id @default(uuid()) @db.Uuid
  tenantId            String                           @map("tenant_id") @db.Uuid
  financialDocumentId String                           @map("financial_document_id") @db.Uuid
  eventType           FinancialDocumentAuditEventType  @map("event_type")
  message             String
  actorUserId         String?                          @map("actor_user_id") @db.Uuid
  occurredAt          DateTime                         @default(now()) @map("occurred_at")
  createdAt           DateTime                         @default(now()) @map("created_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  document FinancialDocument @relation(fields: [financialDocumentId], references: [id], onDelete: Cascade)

  @@index([tenantId, financialDocumentId, occurredAt])
  @@map("financial_document_audit_events")
}

