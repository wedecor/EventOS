// ---------------------------------------------------------------------------
// P2-02 — Checklist Templates & Event Checklists
// ---------------------------------------------------------------------------

enum ChecklistTemplateStatus {
  active
  inactive
  archived

  @@map("checklist_template_status")
}

/// Reusable checklist template (P2-02). Independent of Task; generates EventChecklist copies.
model ChecklistTemplate {
  id               String                  @id @default(uuid()) @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  name             String
  description      String?
  /// Event type labels this template applies to (empty = all types).
  eventTypes       String[]                @default([]) @map("event_types")
  /// Aligns with TaskCategory values for workspace grouping continuity.
  category         TaskCategory            @default(general)
  status           ChecklistTemplateStatus @default(active)
  /// Human-visible template revision (increments on versioned duplicate).
  templateVersion  Int                     @default(1) @map("template_version")
  sortOrder        Int                     @default(0) @map("sort_order")
  /// Stable family id across versioned duplicates (defaults to own id).
  rootTemplateId   String                  @map("root_template_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  version          Int                     @default(1)

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items    ChecklistTemplateItem[]
  generated EventChecklist[]

  @@index([tenantId, status])
  @@index([tenantId, rootTemplateId, templateVersion])
  @@index([tenantId, category])
  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  templateId               String   @map("template_id") @db.Uuid
  title                    String
  description              String?
  isRequired               Boolean  @default(true) @map("is_required")
  defaultAssigneeRole      String?  @map("default_assignee_role")
  estimatedDurationMinutes Int?     @map("estimated_duration_minutes")
  sortOrder                Int      @default(0) @map("sort_order")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  version                  Int      @default(1)

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([tenantId, templateId, sortOrder])
  @@map("checklist_template_items")
}

/// Event-specific checklist copy generated from a template (immutable vs future template edits).
model EventChecklist {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  bookingId       String       @map("booking_id") @db.Uuid
  templateId      String?      @map("template_id") @db.Uuid
  templateVersion Int?         @map("template_version")
  name            String
  description     String?
  category        TaskCategory @default(general)
  sortOrder       Int          @default(0) @map("sort_order")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  version         Int          @default(1)

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  booking  Event                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  template ChecklistTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items    EventChecklistItem[]

  @@index([tenantId, bookingId])
  @@index([tenantId, templateId])
  @@map("event_checklists")
}

model EventChecklistItem {
  id                       String    @id @default(uuid()) @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  checklistId              String    @map("checklist_id") @db.Uuid
  title                    String
  description              String?
  isRequired               Boolean   @default(true) @map("is_required")
  defaultAssigneeRole      String?   @map("default_assignee_role")
  estimatedDurationMinutes Int?      @map("estimated_duration_minutes")
  sortOrder                Int       @default(0) @map("sort_order")
  isCompleted              Boolean   @default(false) @map("is_completed")
  completedAt              DateTime? @map("completed_at")
  completedByUserId        String?   @map("completed_by_user_id") @db.Uuid
  notes                    String?
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  version                  Int       @default(1)

  checklist   EventChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completedBy User?          @relation("EventChecklistItemCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, checklistId, sortOrder])
  @@map("event_checklist_items")
}

// ---------------------------------------------------------------------------
