/// Vendor directory with status + lightweight issue history (`07-domain-model.md` §Vendor,
/// EP1-VEN-001, EP1-VEN-006). Tax details are optional per `07-vendor-management.md` §11A.
model Vendor {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  name              String
  category          String
  status            VendorStatus @default(active)
  contactName       String?      @map("contact_name")
  contactPhone      String?      @map("contact_phone")
  location          String?
  servicesProvided  String?      @map("services_provided")
  pricingNotes      String?      @map("pricing_notes")
  paymentTerms      String?      @map("payment_terms")
  taxDetails        String?      @map("tax_details")
  notes             String?
  /// P2-06 — Operational performance counters (not an analytics dashboard).
  procurementCount           Int @default(0) @map("procurement_count")
  onTimeDeliveryCount        Int @default(0) @map("on_time_delivery_count")
  completedProcurementCount  Int @default(0) @map("completed_procurement_count")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  version           Int          @default(1)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  issueNotes   VendorIssueNote[]
  procurements VendorProcurement[]
