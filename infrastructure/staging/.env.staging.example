# Event OS — staging environment template (R2-05 / docs/16)
#
# Copy to `.env.staging` (gitignored) and fill from a secret manager.
# NEVER commit real secrets. NEVER bake secrets into Docker images.
#
#   cp infrastructure/staging/.env.staging.example infrastructure/staging/.env.staging
#
# Names below match the running API where they differ from docs/16
# (CORS_ORIGIN vs CORS_ORIGINS; REDIS_HOST/PORT vs REDIS_URL).

# ---------------------------------------------------------------------------
# Currently required to boot the API (validated by apps/api env.schema)
# ---------------------------------------------------------------------------

NODE_ENV=staging
PORT=4000
LOG_LEVEL=info

# Explicit staging web origin(s). Must NOT be "*".
CORS_ORIGIN=https://staging.eventos.app

# Managed PostgreSQL (replace host/user/password/db)
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/eventos_staging?schema=public&sslmode=require

# Managed Redis (app uses discrete host/port/password — not REDIS_URL)
REDIS_HOST=REPLACE_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD

# JWT access-token signing key — minimum 32 characters (256 bits)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ---------------------------------------------------------------------------
# Optional — R2-06 Sentry (env.schema accepts this; init only when valid)
# ---------------------------------------------------------------------------

# Replace with a real staging DSN from the Sentry project. Template placeholders
# containing REPLACE are ignored so a copied example cannot enable Sentry.
SENTRY_DSN=https://REPLACE_PUBLIC@REPLACE_HOST/REPLACE_PROJECT

# ---------------------------------------------------------------------------
# Staging readiness (docs/16) — provision secrets early; not yet required
# by env.schema / application bootstrap. Wired in later backlog items.
# ---------------------------------------------------------------------------

# Public staging URL (email links, absolute redirects)
APP_URL=https://staging.eventos.app

# S3-compatible object storage — R2-09 repository preparation
# (docs/16 names). See infrastructure/storage/README.md for layout, limits,
# retention, and security. NOT validated by apps/api env.schema yet.
STORAGE_ENDPOINT=https://REPLACE_STORAGE_ENDPOINT
STORAGE_ACCESS_KEY=REPLACE_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_STORAGE_SECRET_KEY
STORAGE_BUCKET=eventos-staging

# AI provider — Phase 1 optional / later wiring
AI_PROVIDER_API_KEY=REPLACE_AI_PROVIDER_API_KEY

# Transactional email
EMAIL_API_KEY=REPLACE_EMAIL_API_KEY

# Documented in docs/16; Phase 1 does not consume a separate refresh signer.
# Leave unset / placeholder until an ADR introduces it.
# JWT_REFRESH_SECRET=REPLACE_ONLY_IF_ADR_REQUIRES
