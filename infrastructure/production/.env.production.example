# Event OS — production environment template (R5-02 / docs/16)
#
# Copy to `.env.production` (gitignored) and fill from a secret manager.
# NEVER commit real secrets. NEVER bake secrets into Docker images.
#
#   cp infrastructure/production/.env.production.example infrastructure/production/.env.production
#
# Names match apps/api env.schema (authoritative for boot).

# ---------------------------------------------------------------------------
# Required to boot the API (validated by apps/api env.schema)
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Explicit production Admin Portal origin(s). Must NOT be "*".
# Include every HTTPS origin that serves apps/web (CDN + custom domain).
CORS_ORIGIN=https://app.eventos.app

# Managed PostgreSQL (sslmode=require recommended)
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/eventos?schema=public&sslmode=require

# Managed Redis (app uses discrete host/port/password — not REDIS_URL)
REDIS_HOST=REPLACE_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD

# JWT access-token signing key — minimum 32 characters (256 bits).
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ---------------------------------------------------------------------------
# Optional — Sentry (R2-06). Leave unset until a real DSN is provisioned.
# ---------------------------------------------------------------------------

# SENTRY_DSN=https://REPLACE_PUBLIC@o0.ingest.sentry.io/REPLACE_PROJECT

# ---------------------------------------------------------------------------
# Documented for production readiness (docs/16) — not yet required by env.schema
# ---------------------------------------------------------------------------

APP_URL=https://app.eventos.app

# S3-compatible object storage — prep in infrastructure/storage (Phase 1 upload wiring later)
STORAGE_ENDPOINT=https://REPLACE_STORAGE_ENDPOINT
STORAGE_ACCESS_KEY=REPLACE_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_STORAGE_SECRET_KEY
STORAGE_BUCKET=eventos-production

# AI / email — provision early; not consumed by current bootstrap
AI_PROVIDER_API_KEY=REPLACE_AI_PROVIDER_API_KEY
EMAIL_API_KEY=REPLACE_EMAIL_API_KEY

# ---------------------------------------------------------------------------
# Frontend build-time public env (apps/web) — bake into static export
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=https://api.eventos.app
# NEXT_PUBLIC_APP_NAME=Event OS
