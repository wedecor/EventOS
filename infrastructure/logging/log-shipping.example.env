# Event OS — log shipping placeholders (R2-07)
#
# Copy values into the operator’s secret manager / shipper config outside this
# repository. Leave unset in the API container — the Nest app does not read
# these variables today. Stdout JSON is the shipping contract.
#
# NEVER commit real credentials.

# Logical service name (must match log field `service`)
LOG_SERVICE_NAME=event-os-api

# Recommended application log level for staging/production (API reads LOG_LEVEL)
# LOG_LEVEL=info

# Aggregator endpoint placeholders (shipper-side only — not consumed by apps/api)
# LOG_AGGREGATOR_ENDPOINT=https://REPLACE_AGGREGATOR_INGEST
# LOG_AGGREGATOR_API_KEY=REPLACE_AGGREGATOR_API_KEY

# Retention targets (docs/16) — configure in the aggregator, not the app
# LOG_RETENTION_HOT_DAYS=30
# LOG_RETENTION_COLD_DAYS=365

# Correlation field to index for request trails
# LOG_CORRELATION_FIELD=requestId
