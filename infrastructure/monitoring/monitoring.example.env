# Event OS — external monitoring placeholders (R2-08)
#
# Used by operator tooling outside this repository.
# The Nest API does NOT read these variables today.
# NEVER commit real webhook URLs or API keys.

# Public base URL for synthetic probes (staging example)
# MONITOR_BASE_URL=https://staging.eventos.app

# Probe paths (docs/16)
# MONITOR_LIVENESS_PATH=/health
# MONITOR_READINESS_PATH=/health/ready
# MONITOR_PROBE_INTERVAL_SECONDS=30

# Alert notification placeholders (shipper / monitor side only)
# MONITOR_ALERT_WEBHOOK_URL=https://REPLACE_ALERT_WEBHOOK
# MONITOR_ONCALL_CONTACT=REPLACE_ONCALL

# Optional: Sentry project link for operators (DSN stays in app secrets)
# MONITOR_SENTRY_PROJECT_URL=https://REPLACE_SENTRY_ORG/REPLACE_PROJECT
