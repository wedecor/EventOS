# Event OS — object storage placeholders (R2-09 / docs/16)
#
# Copy into the operator secret manager or staging .env (gitignored).
# apps/api does NOT validate or consume these at bootstrap yet.
# NEVER commit real keys.

# S3-compatible API endpoint (AWS S3, MinIO, DigitalOcean Spaces, Cloudflare R2, …)
STORAGE_ENDPOINT=https://REPLACE_STORAGE_ENDPOINT

# Access credentials (least privilege on STORAGE_BUCKET only)
STORAGE_ACCESS_KEY=REPLACE_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_STORAGE_SECRET_KEY

# Bucket name (one bucket per environment)
STORAGE_BUCKET=eventos-staging

# Optional — only when a later SDK wiring task documents them (NOT in docs/16 required table):
# STORAGE_REGION=REPLACE_REGION
# STORAGE_FORCE_PATH_STYLE=true
